# Neon Postgres — auto-populated by `vercel env pull .env.local` once the
# Neon integration is connected to this Vercel project (see README).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Telegram bot config
BOT_TOKEN=""
WEBHOOK_SECRET=""
WEBHOOK_URL=""

# Захищає /api/cron від сторонніх викликів. Vercel Cron надсилає його як
# `Authorization: Bearer <CRON_SECRET>`. Якщо не заданий — перевірка вимкнена
# (зручно локально, але на проді задайте обов'язково).
CRON_SECRET=""

# Vercel AI Gateway — назва подарунка з будь-якого посилання (ADR 0006).
# Без ключа бот не ламається: назву бере з розмітки, а де розмітка нікчемна —
# просить написати назву самому. AI_GIFT_NAME_MODEL і AI_GATEWAY_URL — необов'язкові.
AI_GATEWAY_API_KEY=""
