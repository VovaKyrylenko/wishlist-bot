{
  "name": "wishlist-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Мінімалістичний Telegram-бот для створення та поширення вішлістів",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch scripts/dev-polling.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "webhook:set": "tsx scripts/set-webhook.ts",
    "webhook:delete": "tsx scripts/delete-webhook.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "vercel-build": "prisma generate && prisma migrate deploy",
    "verify:flows": "tsx scripts/flows/run.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vercel/node": "^5.10.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "author": "Volodymyr Kyrylenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VovaKyrylenko/wishlist-bot.git"
  },
  "bugs": {
    "url": "https://github.com/VovaKyrylenko/wishlist-bot/issues"
  },
  "homepage": "https://github.com/VovaKyrylenko/wishlist-bot#readme"
}
